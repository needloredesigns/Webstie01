<section class="category-circles-section py-8 lg:py-12">
  <div class="category-circles-inner">
    <div class="category-circles-scroll">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="category-circle-link">
          <div class="category-circle-image-wrap">
            {% if block.settings.image %}
              <img src="{{ block.settings.image | image_url: width: 300 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {% else %}
              <img src="{{ block.settings.fallback_image | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {% endif %}
          </div>
          <span class="category-circle-title">{{ block.settings.title }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<style>
.category-circles-section { padding: 2rem 0; }
@media (min-width: 1024px) { .category-circles-section { padding: 3rem 0; } }
.category-circles-inner { max-width: 80rem; margin: 0 auto; padding: 0 1rem; }
.category-circles-scroll { display: flex; gap: 1.25rem; overflow-x: auto; padding-bottom: 1rem; scrollbar-width: none; }
.category-circles-scroll::-webkit-scrollbar { display: none; }
@media (min-width: 640px) { .category-circles-scroll { gap: 2rem; } }
@media (min-width: 1024px) { .category-circles-scroll { gap: 3rem; justify-content: center; } }
.category-circle-link { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
.category-circle-image-wrap { position: relative; width: 6rem; height: 6rem; border-radius: 50%; overflow: hidden; border: 2px solid var(--color-border); transition: border-color 0.3s; }
.category-circle-link:hover .category-circle-image-wrap { border-color: var(--color-primary); }
@media (min-width: 640px) { .category-circle-image-wrap { width: 7rem; height: 7rem; } }
@media (min-width: 1024px) { .category-circle-image-wrap { width: 8rem; height: 8rem; } }
.category-circle-image-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
.category-circle-link:hover .category-circle-image-wrap img { transform: scale(1.1); }
.category-circle-title { margin-top: 0.5rem; font-size: 0.75rem; color: var(--color-text); text-align: center; max-width: 6rem; line-height: 1.2; letter-spacing: 0.025em; }
@media (min-width: 640px) { .category-circle-title { font-size: 0.875rem; } }
</style>

{% schema %}
{
  "name": "Category Circles",
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Category Name" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Custom Image" },
        { "type": "text", "id": "fallback_image", "label": "Fallback image filename (e.g. cat-tops.jpg)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Circles",
      "blocks": [
        { "type": "category", "settings": { "title": "Tops", "fallback_image": "cat-tops.jpg" } },
        { "type": "category", "settings": { "title": "Shirts", "fallback_image": "cat-shirts.jpg" } },
        { "type": "category", "settings": { "title": "Dresses", "fallback_image": "cat-dresses.jpg" } },
        { "type": "category", "settings": { "title": "Skirts", "fallback_image": "cat-skirts.jpg" } },
        { "type": "category", "settings": { "title": "Coord Sets", "fallback_image": "cat-coord.jpg" } },
        { "type": "category", "settings": { "title": "Premium Loungewear", "fallback_image": "cat-loungewear.jpg" } },
        { "type": "category", "settings": { "title": "Gifting", "fallback_image": "cat-gifting.jpg" } }
      ]
    }
  ]
}
{% endschema %}
