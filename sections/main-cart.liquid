<section class="cart-page">
  <div class="cart-page__inner">
    <h1 class="section-title" style="text-align:center;margin-bottom:2.5rem">Your Bag</h1>
    {% if cart.item_count == 0 %}
      <div style="text-align:center;padding:4rem 0">
        <p style="color:var(--color-muted)">Your bag is currently empty.</p>
        <a href="/collections/all" class="btn-primary" style="margin-top:1.5rem;display:inline-block">Continue Shopping</a>
      </div>
    {% else %}
      <form action="/cart" method="post">
        <div class="cart-items">
          {% for item in cart.items %}
            <div class="cart-item">
              <a href="{{ item.url }}" class="cart-item__image"><img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}"></a>
              <div class="cart-item__details">
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                <p class="cart-item__variant">{{ item.variant.title }}</p>
                <div class="cart-item__qty">
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" class="cart-item__qty-input">
                </div>
              </div>
              <span class="cart-item__price">{{ item.final_line_price | money }}</span>
            </div>
          {% endfor %}
        </div>
        <div class="cart-summary">
          <div class="cart-summary__row"><span>Subtotal</span><span>{{ cart.total_price | money }}</span></div>
          <p style="font-size:.75rem;color:var(--color-muted)">Shipping & taxes calculated at checkout.</p>
          <button type="submit" name="checkout" class="btn-primary" style="width:100%;margin-top:1rem">Checkout</button>
          <button type="submit" name="update" class="btn-secondary" style="width:100%;margin-top:.5rem">Update Bag</button>
        </div>
      </form>
    {% endif %}
  </div>
</section>
{% schema %}{"name":"Cart","tag":"section"}{% endschema %}
