<section class="collection-page"><div class="collection-page__inner">
  <div class="collection-page__header"><h1 class="section-title">All Collections</h1></div>
  <div class="product-grid">
    {% for collection in collections %}
      {% if collection.products_count > 0 %}
      <a href="{{ collection.url }}" class="collection-card">
        {% if collection.image %}<img src="{{ collection.image | image_url: width: 400 }}" alt="{{ collection.title | escape }}" class="collection-card__image">{% endif %}
        <h3 class="collection-card__title">{{ collection.title }}</h3>
      </a>
      {% endif %}
    {% endfor %}
  </div>
</div></section>
{% schema %}{"name":"Collection list","tag":"section"}{% endschema %}
